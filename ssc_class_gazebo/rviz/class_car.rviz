Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /LaserScan1
      Splitter Ratio: 0.55
  - Class: rviz_common/Views
    Name: Views
    Expanded:
      - /Current View1
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 2
      Plane Cell Count: 30
      Alpha: 0.25
      Color: 110; 110; 120
      Reference Frame: base_link
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Names: true
      Show Arrows: false
      Marker Scale: 2
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Name: Car (base_link)
      Reference Frame: base_link
      Length: 1.5
      Radius: 0.15
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: LaserScan
      Topic:
        Value: /scan
        Depth: 5
        Reliability Policy: Best Effort
      Size (Pixels): 6
      Style: Points
      Color Transformer: FlatColor
      Color: 255; 40; 40
      Decay Time: 0
    - Class: rviz_default_plugins/Odometry
      Enabled: false
      Name: Odometry
      Topic:
        Value: /odom
      Keep: 100
      Position Tolerance: 0.5
      Angle Tolerance: 0.2
      Shape:
        Value: Axes
        Axes Length: 0.5
        Axes Radius: 0.05
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Camera
      Topic:
        Value: /camera/image_raw
        Reliability Policy: Best Effort
  Global Options:
    Background Color: 40; 42; 52
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 36
      Pitch: 1.0
      Yaw: 0.0
      Focal Point:
        X: 6
        Y: 0
        Z: 0
      Target Frame: base_link
Window Geometry:
  Camera:
    collapsed: false
  Displays:
    collapsed: false
  Views:
    collapsed: true
  Height: 900
  Width: 1400
