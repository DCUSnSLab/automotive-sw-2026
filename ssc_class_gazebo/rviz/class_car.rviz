Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 2
      Plane Cell Count: 30
      Alpha: 0.3
      Reference Frame: odom
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Names: true
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: LaserScan
      Topic:
        Value: /scan
        Depth: 5
        Reliability Policy: Best Effort
      Size (m): 0.2
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 40; 40
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Odometry
      Topic:
        Value: /odom
      Keep: 200
      Shape:
        Shaft Length: 0.3
        Head Length: 0.1
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Camera
      Topic:
        Value: /camera/image_raw
        Reliability Policy: Best Effort
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 26
      Pitch: 1.15
      Yaw: 3.9
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Target Frame: base_link
Window Geometry:
  Camera:
    collapsed: false
  Height: 900
  Width: 1400
