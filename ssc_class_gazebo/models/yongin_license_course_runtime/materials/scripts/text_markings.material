
material Yongin/TextMarking_00_e105
{
  technique
  {
    pass
    {
      lighting off
      scene_blend alpha_blend
      alpha_rejection greater 128
      depth_write off
      depth_bias 20 0
      cull_hardware none
      cull_software none
      diffuse 1 1 1 1
      ambient 1 1 1 1
      texture_unit
      {
        texture text_marking_00_e105.png
        filtering trilinear
      }
    }
  }
}


