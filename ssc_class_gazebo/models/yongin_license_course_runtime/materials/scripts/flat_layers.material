
material Yongin/RoadSurface
{
  technique
  {
    pass
    {
      lighting on
      depth_check on
      depth_write on
      depth_bias 1 0
      cull_hardware none
      cull_software none
      ambient 1 1 1 1
      diffuse 1 1 1 1
      specular 0.02 0.02 0.02 1
      texture_unit
      {
        texture asphalt_texture.jpg
        filtering anisotropic anisotropic linear
        max_anisotropy 8
      }
    }
  }
}


