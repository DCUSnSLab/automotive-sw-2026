<?xml version="1.0"?>
<model>
  <name>LCS-5004 lane control vehicle</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author>
    <name>DCUSnSLab</name>
  </author>
  <description>
    Kinematic deployed approximation of the JB Solution LCS-5004 lane control
    vehicle. It can be repositioned with Gazebo's model manipulator while
    remaining unaffected by physics. Overall vehicle dimensions and
    signal-panel sizes follow the manufacturer drawings; detailed body geometry
    is simplified for simulation.
  </description>
</model>
