material LCS5004/Off
{
  technique
  {
    pass
    {
      lighting on
      ambient 0 0 0 1
      diffuse 0 0 0 1
      specular 0 0 0 1
      emissive 0 0 0 1
    }
  }
}

material LCS5004/ArrowDown
{
  technique
  {
    pass
    {
      lighting on
      ambient 0.04 0.12 0.08 1
      diffuse 0.12 0.65 0.30 1
      emissive 0.03 0.90 0.34 1
      texture_unit
      {
        texture arrow_down.png
        filtering anisotropic
        max_anisotropy 8
      }
    }
  }
}

