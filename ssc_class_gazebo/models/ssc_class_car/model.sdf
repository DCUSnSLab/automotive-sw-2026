        <pose>0 0 -0.2175 0 0 0</pose>
        <geometry><cylinder><radius>0.025</radius><length>0.245</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.32 1</ambient><diffuse>0.3 0.3 0.32 1</diffuse></material>
      </visual>
      <visual name="lidar_scan_ring">
        <pose>0 0 -0.01 0 0 0</pose>
        <geometry>
