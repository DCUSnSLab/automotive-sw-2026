        </material>
      </visual>
      <collision name="lidar_base_collision">
        <pose>0 0 -0.065 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.07</radius>
            <length>0.06</length>
          </cylinder>
        </geometry>
      </collision>
      <sensor name="roof_lidar" type="ray">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.141592653589793</min_angle>
              <max_angle>3.1328660073298216</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.15</min>
            <max>30</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
              <plugin name="roof_lidar_controller" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <remapping>~/out:=scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>roof_lidar_link</frame_name>
        </plugin>
      </sensor>
    </link>
    <joint name="roof_lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>roof_lidar_link</child>
    </joint>
    <link name="steering_wheel_link">
      <pose relative_to="base_link">0.20 0 0.40 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia>
      </inertial>
    </link>
    <joint name="steering_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>steering_wheel_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-7.85</lower><upper>7.85</upper></limit>
      </axis>
    </joint>
    <!-- 2026-09-22 검증 반영: 뒷바퀴 조인트 effort 10→200·velocity 10→30·마찰 15→0.1, 조향 조인트 effort 10→50·velocity 1→3.
         원래 값으로는 토크 기반 ackermann 플러그인이 바퀴를 못 돌려 차가 6초에 1 cm 움직였다. max_speed 5→3 m/s (코스 주행감).
         센서 <visualize>는 false — 720개 광선 시각화가 화면을 덮고 노트북 성능을 갉아먹는다. -->
    <plugin name="ackermann_drive" filename="libgazebo_ros_ackermann_drive.so">
      <ros>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
        <remapping>distance:=distance</remapping>
      </ros>
      <update_rate>100.0</update_rate>
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <rear_left_joint>rear_left_wheel_joint</rear_left_joint>
      <rear_right_joint>rear_right_wheel_joint</rear_right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <steering_wheel_joint>steering_wheel_joint</steering_wheel_joint>
      <max_steer>0.461</max_steer>
      <max_steering_angle>7.85</max_steering_angle>
      <max_speed>3.0</max_speed>
      <!-- TODO(TA): 조향 링크 질량이 5 g로 매우 가벼움. 진동/발산 시 게인 하향 조정 -->
      <left_steering_pid_gain>100 0 1</left_steering_pid_gain>
      <left_steering_i_range>0 0</left_steering_i_range>
      <right_steering_pid_gain>100 0 1</right_steering_pid_gain>
      <right_steering_i_range>0 0</right_steering_i_range>
      <linear_velocity_pid_gain>500 0 1</linear_velocity_pid_gain>
      <linear_velocity_i_range>0 0</linear_velocity_i_range>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <publish_distance>false</publish_distance>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
    <plugin name="ground_truth" filename="libgazebo_ros_p3d.so">
      <ros>
        <remapping>odom:=ground_truth/odom</remapping>
      </ros>
      <body_name>base_link</body_name>
      <frame_name>world</frame_name>
      <update_rate>30.0</update_rate>
    </plugin>
    <static>0</static>
  </model>
</sdf>
