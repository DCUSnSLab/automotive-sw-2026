<?xml version='1.0' encoding='utf-8'?>
<model>
  <name>SSC classroom car (rip, low-memory)</name>
  <version>1.2</version>
  <sdf version="1.7">model.sdf</sdf>
  <author>
    <name>SSC / Hunter model contributors</name>
  </author>
  <description>Low-memory variant of ssc_class_car (decimated STL meshes, 800x450 camera) used by license_course_rip.launch.py. Gazebo Classic classroom car with a 360-degree 2D lidar at 0.45 m above ground and one front RGB camera at 0.82 m. ROS controllers and project plugins are excluded.</description>
</model>
